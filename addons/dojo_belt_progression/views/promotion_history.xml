<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View for Promotion History -->
    <record id="view_member_rank_list" model="ir.ui.view">
        <field name="name">dojo.member.rank.list</field>
        <field name="model">dojo.member.rank</field>
        <field name="arch" type="xml">
            <list string="Promotion History" create="false" edit="false">
                <field name="date_awarded"/>
                <field name="member_id"/>
                <field name="rank_id"/>
                <field name="awarded_by"/>
                <field name="program_id"/>
                <field name="stripe_count"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View for Promotion History -->
    <record id="view_member_rank_form" model="ir.ui.view">
        <field name="name">dojo.member.rank.form</field>
        <field name="model">dojo.member.rank</field>
        <field name="arch" type="xml">
            <form string="Promotion Record" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="rank_id"/>
                            <field name="date_awarded"/>
                        </group>
                        <group>
                            <field name="awarded_by"/>
                            <field name="program_id"/>
                            <field name="stripe_count"/>
                            <field name="test_registration_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Promotion History -->
    <record id="action_promotion_history" model="ir.actions.act_window">
        <field name="name">Promotion History</field>
        <field name="res_model">dojo.member.rank</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Entry for Promotion History -->
    <menuitem
        id="menu_promotion_history"
        name="Promotion History"
        parent="dojo_core.menu_dojo_core_root"
        action="action_promotion_history"
        sequence="16"/>

</odoo>
