<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Export Wizard Form -->
    <record id="view_dojo_export_wizard_form" model="ir.ui.view">
        <field name="name">dojo.export.wizard.form</field>
        <field name="model">dojo.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Data">
                <group>
                    <field name="export_type" widget="radio"/>
                </group>
                <footer>
                    <button string="Export CSV" type="object" name="action_export_csv" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Export Wizard Action -->
    <record id="action_dojo_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Data</field>
        <field name="res_model">dojo.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dojo_export_wizard"/>
    </record>
</odoo>
